{
  "name": "gr-4d-gravity-simulator",
  "private": true,
  "version": "0.8.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/validate-pages-build.mjs",
    "preview": "vite preview",
    "stats": "node scripts/project-stats.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:physics": "vitest run tests/physics",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "test:soak": "node scripts/render-soak.mjs",
    "test:benchmark": "node scripts/render-benchmark.mjs",
    "benchmark:scale": "node scripts/render-scale-benchmark.mjs",
    "screenshots:scale": "node scripts/capture-scale-screenshots.mjs",
    "benchmark:physics": "node scripts/physics-benchmark.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
